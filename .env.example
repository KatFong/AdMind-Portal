# ─── Database ────────────────────────────────────────────────────────────────
# Development (SQLite)
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL)
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# ─── AI Provider (choose one) ─────────────────────────────────────────────────
AI_PROVIDER="deepseek"        # deepseek | openai | groq | perplexity | azure
AI_MODEL="deepseek-chat"

# DeepSeek (recommended for HK users)
DEEPSEEK_API_KEY="sk-..."

# OpenAI (if available in your region)
# OPENAI_API_KEY="sk-..."

# Groq (free tier available)
# GROQ_API_KEY="gsk_..."

# Perplexity
# PERPLEXITY_API_KEY="pplx-..."

# Azure OpenAI
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_DEPLOYMENT=""

# ─── Web Search (Competitive Intelligence) ────────────────────────────────────
# Sign up free at https://tavily.com
TAVILY_API_KEY="tvly-..."

# ─── Security (Encryption for stored API tokens) ──────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-32-byte-hex-key-here"

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_SECRET="your-scheduler-secret"

# ─── Meta / Facebook & Instagram (optional, for real publishing) ──────────────
# META_APP_ID=""
# META_APP_SECRET=""

# ─── Google Ads (optional) ────────────────────────────────────────────────────
# GOOGLE_ADS_CLIENT_ID=""
# GOOGLE_ADS_CLIENT_SECRET=""
# GOOGLE_ADS_DEVELOPER_TOKEN=""
